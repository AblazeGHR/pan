    def _wait_for(predicate, *, timeout: float = 15.0, label: str = "condition"):
        deadline = time.monotonic() + timeout
        last = None
        while time.monotonic() < deadline:
            try:
                value = predicate()
                if value:
                    return value
                last = value
            except Exception as exc:  # startup/race polling only
                last = exc
            time.sleep(0.025)
