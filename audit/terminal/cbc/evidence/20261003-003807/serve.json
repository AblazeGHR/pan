    "body_head": "<!DOCTYPE html>\n<html lang=\"zh\" class=\"dark\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content\">\n    <title>CodeBuddy Code Remote Control</title>\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/logo.svg\">\n    <!-- 初始使用深色顶栏；应用启动后会随当前主题同步更新。 -->\n    <meta name=\"theme-color\" content=\"#1f1f1f\">\n    <meta name=\"description\" content=\"CodeBuddy Code - AI-powered coding assistant\">\n    <!-- PWA / Standalone：隐藏浏览器导航栏 -->\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n    <meta name=\"mobile-web-app-capable\" content=\"yes\">\n    <link rel=\"apple-touch-icon\" href=\"/pwa-icon.svg\">\n    <style id=\"cb-boot-bg\">html,body{background:#000;color-scheme:dark}</style>\n    <script>\n        // 防白屏：必须在 head 里跑。iframe 首帧是 about:blank（白），\n        // 文档一到就要带上主题底色；等 body / CSS 再设已经晚了。\n        // `theme` 由宿主 iframe URL 注入（独立 origin 无法共享宿主 localStorage）。\n        (function () {\n            try {\n                var theme = new URLSearchParams(window.location.search).get('theme');\n                var resolved = theme === 'light' ? 'light' : 'dark';\n                var bg = resolved === 'dark' ? '#000000' : '#ffffff';\n                document.documentElement.setAttribute('data-theme', resolved);\n                document.documentElement.style.colorScheme = resolved;\n                document.documentElement.style.backgroundColor = bg;\n                var boot = document.getElementById('cb-boot-bg');\n                if (boot) {\n                    boot.textContent = 'html,body{background:' + bg + ';color-scheme:' + resolved + '}';\n                }\n            } catch (e) {\n                /* ignore */\n            }\n        })();\n    </script>\n  <script type=\"module\" crossorigin src=\"/assets/index