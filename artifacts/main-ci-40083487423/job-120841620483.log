2026-10-24T10:25:05.2515295Z         root = Path(__file__).resolve().parents[1]
2026-10-24T10:25:05.2515827Z         rt = h._PanRuntime(tmp_path/'data')
2026-10-24T10:25:05.2516289Z         rt.data_root.mkdir()
2026-10-24T10:25:05.2516989Z         (rt.data_root/'config.json').write_text(json.dumps({'scheduler': {'enabled': True},
2026-10-24T10:25:05.2517926Z             'memory': {'enabled': False}, 'plugin_manifests': [str(root/'manifest.json'),
2026-10-24T10:25:05.2518785Z             str(root/'packages/mcp/manifest.json')]}), encoding='utf-8')
2026-10-24T10:25:05.2519621Z         evidence = {'port': h.PORT, 'dataRoot': str(rt.data_root), 'realProvider': False}
2026-10-24T10:25:05.2520758Z         evidence['sourceSha']=subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,encoding='utf-8').strip()
2026-10-24T10:25:05.2522141Z         evidence['productionIndexSha256']=hashlib.sha256((root/'packages/web/dist/index.html').read_bytes()).hexdigest()
2026-10-24T10:25:05.2523410Z         def stop():
2026-10-24T10:25:05.2523674Z             owned = []
2026-10-24T10:25:05.2524025Z             if rt.process and rt.process.poll() is None:
2026-10-24T10:25:05.2524455Z                 parent = psutil.Process(rt.process.pid)
2026-10-24T10:25:05.2524901Z                 owned = [parent, *parent.children(recursive=True)]
2026-10-24T10:25:05.2525330Z                 for p in owned:
2026-10-24T10:25:05.2525629Z                     try:
2026-10-24T10:25:05.2526107Z                         rt._owned_processes.append((p.pid, p.create_time(), ' '.join(p.cmdline())))
2026-10-24T10:25:05.2526631Z                     except psutil.Error:
2026-10-24T10:25:05.2526980Z                         pass
2026-10-24T10:25:05.2527263Z             rt.stop()
2026-10-24T10:25:05.2527631Z             _, live = psutil.wait_procs(owned, timeout=5)
2026-10-24T10:25:05.2528087Z             assert not live, [(p.pid, p.status()) for p in live]
2026-10-24T10:25:05.2528454Z         try:
2026-10-24T10:25:05.2528736Z             rt.start()
