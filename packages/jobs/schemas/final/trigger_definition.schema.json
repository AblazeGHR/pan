{
  "title": "Trigger definition",
  "description": "Pure matching and durable admission to a Job or fixed Action.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string"
    },
    "eventTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "creatorSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "ids"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^\\S(?:.*\\S)?$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "mode",
            "ids"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "registeredType"
            },
            "providerType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "mode",
            "providerType"
          ]
        }
      ]
    },
    "eventFilter": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/Condition"
        }
      ]
    },
    "arguments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/Binding"
      }
    },
    "targetJobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "action"
            },
            "actionRef": {
              "$ref": "common.schema.json#/$defs/Ref"
            }
          },
          "required": [
            "type",
            "actionRef"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "job"
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "configRevision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "jobId",
            "configRevision"
          ]
        }
      ]
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxActive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxPending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      },
      "required": [
        "maxActive",
        "maxPending"
      ]
    },
    "managedByComposition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "name",
    "eventTypes",
    "creatorSelector"
  ],
  "oneOf": [
    {
      "required": [
        "targetJobId"
      ],
      "not": {
        "required": [
          "target"
        ]
      }
    },
    {
      "required": [
        "target"
      ],
      "not": {
        "required": [
          "targetJobId"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pan.local/pan/job-final/v2/trigger_definition.schema.json",
  "$comment": "Generated from packages/jobs/final_contracts.py; do not edit by hand. Run python -m packages.jobs.final_contracts --write."
}
