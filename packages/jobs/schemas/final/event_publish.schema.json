{
  "title": "Event publish envelope",
  "description": "Immutable drive fact. Provider identity is bound by the trusted publish service.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "eventSchemaRevision": {
      "type": "integer",
      "minimum": 1
    },
    "creatorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "creatorRevision": {
      "type": "integer",
      "minimum": 1
    },
    "occurrenceKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "occurredAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
    },
    "emittedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
    },
    "payload": {}
  },
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "eventSchemaRevision",
    "creatorId",
    "creatorRevision",
    "occurrenceKey",
    "occurredAt",
    "payload"
  ],
