{
  "title": "Event Creator definition",
  "description": "Source instance (Scheduler/system/plugin). Cursor and health are server runtime.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string"
    },
    "providerRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "time",
            "core",
            "plugin"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "releaseDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "id",
        "releaseDigest",
        "generation"
      ]
    },
    "configSchemaRef": {
      "$ref": "common.schema.json#/$defs/Ref"
    },
    "config": {
      "type": "object"
    },
    "eventTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "name",
    "providerRef",
    "configSchemaRef",
    "config",
    "eventTypes",
    "requiredCapabilities"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pan.local/pan/job-final/v2/event_creator_definition.schema.json",
  "$comment": "Generated from packages/jobs/final_contracts.py; do not edit by hand. Run python -m packages.jobs.final_contracts --write."
}
