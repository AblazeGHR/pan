{
  "title": "Effect receipt",
  "description": "Effect identity survives queries and retries for the same Run.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "effectKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "operationOrdinal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "runId",
        "stepId",
        "targetId",
        "operationOrdinal"
      ]
    },
    "attemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "attempt": {
      "title": "Attempt record",
      "description": "Optional original execution snapshot captured on receipt commit; missing historical facts never authorize recovery.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "state": {
          "enum": [
            "preparing",
            "running",
            "succeeded",
            "failed",
            "uncertain",
            "cancelled"
          ]
        },
        "ownerEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "startedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "endedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "backoffSeconds": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "invalid_schema",
                "invalid_condition",
                "unsupported_operation",
                "unauthenticated",
                "authorization_denied",
                "not_found",
                "history_expired",
                "log_expired",
                "revision_conflict",
                "request_scope_conflict",
                "idempotency_conflict",
                "reference_conflict",
                "pending_publication",
                "reconciliation_required",
                "not_retryable",
                "cancellation_window_closed",
                "capability_unsupported",
                "unsupported_schema_version",
                "capacity_exceeded",
                "provider_unavailable",
                "storage_unavailable"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "attemptId",
        "runId",
        "stepId",
        "state",
        "ownerEpoch",
        "generation",
        "leaseId"
      ]
    },
    "outcome": {
      "enum": [
        "succeeded",
        "rejected",
        "unknown",
        "partial"
      ]
    },
    "receipt": {
      "type": "object"
    },
    "targetSelection": {
      "type": "object"
    },
    "cleanupProof": {
      "type": "object"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    }
  },
  "required": [
    "effectKey",
    "attemptId",
    "outcome",
    "receipt",
    "createdAt"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pan.local/pan/job-final/v2/effect.schema.json",
  "$comment": "Generated from packages/jobs/final_contracts.py; do not edit by hand. Run python -m packages.jobs.final_contracts --write."
}
