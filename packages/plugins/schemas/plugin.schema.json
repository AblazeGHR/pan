{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pan plugin v1",
  "type": "object",
  "required": ["protocol", "id", "source"],
  "properties": {
    "protocol": {"const": "pan-plugin/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$"},
    "display_name": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["mcp", "pan_api"]},
        "server_ref": {"type": "string", "minLength": 1},
        "capabilities_file": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"kind": {"const": "mcp"}}}, "then": {"required": ["server_ref"]}},
        {"if": {"properties": {"kind": {"const": "pan_api"}}}, "then": {"required": ["capabilities_file"]}}
      ]
    },
    "exposure": {
      "type": "object",
      "properties": {
        "supported_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["standalone", "pan_native", "gateway"]}},
        "default_mode": {"enum": ["standalone", "pan_native", "gateway"]}
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "required": [
        "provider",
        "definitions",
        "subscriptions"
      ],
      "properties": {
        "provider": {
          "type": "object",
          "required": [
            "transport",
            "command_ref"
          ],
          "properties": {
            "transport": {
              "const": "stdio_jsonrpc"
            },
            "command_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "definitions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "type",
              "schema",
              "schemaVersion",
              "description"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128
              },
              "schema": {
                "type": "object"
              },
              "schemaVersion": {
                "type": "integer",
                "minimum": 1
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "additionalProperties": false
          }
        },
        "subscriptions": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128
          }
        }
      },
      "additionalProperties": false
    },
    "message_source": {
      "type": "object",
      "properties": {
        "auto_report_default": {"type": "boolean"},
        "legacy_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "tool_exports": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"}},
    "data": {"type": "object", "properties": {"version": {"type": "integer", "minimum": 1}}, "required": ["version"], "additionalProperties": false},
    "agent_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "panels": {"type": "array", "items": {
      "type": "object", "required": ["id", "title", "renderer", "actions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "renderer": {"enum": ["account-switcher/v1"]},
        "actions": {"type": "object", "minProperties": 1, "additionalProperties": {
          "type": "object", "required": ["capability", "effect"],
          "properties": {"capability": {"type": "string"}, "effect": {"enum": ["read", "write_external"]}},
          "additionalProperties": false
        }}
      }, "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
