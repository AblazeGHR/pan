{
  "name": "pan-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File e2e/run.ps1",
    "e2e:bottom-follow": "powershell -NoProfile -ExecutionPolicy Bypass -File e2e/run-bottom-follow.ps1",
    "e2e:attachment-dnd": "node e2e/attachment-dnd.mock.mjs",
    "e2e:done-indicator": "node e2e/done-indicator.e2e.mjs",
    "e2e:mobile-topbar-compact": "node e2e/mobile-topbar-compact.e2e.mjs",
    "e2e:session-recovery": "node e2e/session-message-recovery.e2e.mjs",
    "e2e:codex-multi-item-order": "node e2e/codex-multi-item-order.e2e.mjs",
    "e2e:frontend-full": "node e2e/frontend-full.e2e.mjs",
    "gen:api": "openapi-typescript http://localhost:8768/api/openapi.json -o src/types/api.d.ts",
    "analyze": "vite-bundle-visualizer"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-virtual": "^3.10.0",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.9",
    "lucide-react": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.0.0",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.3.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0",
    "vite": "^6.0.0",
    "vite-bundle-visualizer": "^1.2.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
