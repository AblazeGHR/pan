#!/usr/bin/env bash
# pre-commit hook — ensures both frontends compile cleanly.
#
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

set -e

staged=$(git diff --cached --name-only)

# Old frontend (Vanilla JS)
if echo "$staged" | grep -q 'packages/web/ts/app.ts'; then
  echo "pre-commit: checking legacy frontend..."
  npx tsc --noEmit 2>&1 || {
    echo ""
    echo "Legacy TypeScript compilation failed. Fix errors and try again."
    exit 1
  }
  echo "Legacy frontend OK"
fi

# New frontend (React)
if echo "$staged" | grep -q 'packages/web/src/'; then
  echo "pre-commit: checking React frontend..."
  cd packages/web && npx tsc -b --noEmit 2>&1 || {
    echo ""
    echo "React TypeScript compilation failed. Fix errors and try again."
    exit 1
  }
  cd - > /dev/null
  echo "React frontend OK"
fi
