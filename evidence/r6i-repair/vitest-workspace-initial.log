<body>
  <div>
    <section
      aria-label="Automation management"
      class="h-full min-w-0 overflow-y-auto p-3 pt-12 text-text-primary sm:p-6"
    >
      <div
        class="mx-auto max-w-6xl space-y-5"
      >
        <header
          class="flex flex-wrap justify-between gap-3"
        >
          <div>
            <h1
              class="text-2xl font-semibold"
            >
              Automation
            </h1>
            <p>
              Jobs, event subscriptions and reusable time sources
            </p>
          </div>
          <div
            class="flex gap-3"
          >
            <a
              data-discover="true"
              href="/automation/canonical"
            >
              Canonical Jobs
            </a>
            <a
              data-discover="true"
              href="/actions"
            >
              Manage Actions
            </a>
          </div>
        </header>
        <section
          aria-label="Job user authorization"
          class="rounded border border-border-default p-3 text-xs space-y-2"
        >
          <p>
            User confirmation uses automation/user.key and the shared login session. Enabled Jobs keep their granted capability after logout.
          </p>
          <form
            class="flex flex-wrap items-end gap-2"
          >
            <label
              class="flex flex-col gap-1"
            >
              <span
                class="text-[11px] text-text-tertiary"
              >
                Local user key
              </span>
              <input
                autocomplete="off"
                class="w-full bg-bg-tertiary border border-border-default rounded text-xs py-1.5 px-2 text-text-primary placeholder:text-text-tertiary outline-none focus:border-accent/50"
                required=""
                type="password"
                value=""
              />
            </label>
            <button
              class="inline-flex items-center gap-1 rounded border font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed bg-bg-tertiary text-text-primary hover:bg-bg-tertiary/80 border-border-default px-3 py-1.5 text-sm "
              type="submit"
            >
              Log in
            </button>
          </form>
        </section>
        <p>
          Log in to manage Jobs and Scheduler sources.
        </p>
        <div
          aria-label="Automation subpages"
          class="grid grid-cols-3 gap-1"
          role="tablist"
        >
          <button
            aria-selected="false"
            role="tab"
            tabindex="-1"
          >
            Job
          </button>
          <button
            aria-selected="true"
            role="tab"
            tabindex="0"
          >
            Trigger
          </button>
          <button
            aria-selected="false"
            role="tab"
            tabindex="-1"
          >
            Event Register
          </button>
        </div>
      </div>
    </section>
  </div>
</body>

