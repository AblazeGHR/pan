+    comspec = os.environ.get('COMSPEC') or os.path.join(
+        os.environ['SystemRoot'], 'System32', 'cmd.exe')
+    if (len(args) == 5 and list(args[1:4]) == ['/d', '/s', '/c']
+            and os.path.normcase(os.path.abspath(args[0]))
+                == os.path.normcase(os.path.abspath(comspec))):
+        return subprocess.list2cmdline(args[:4]) + ' "' + args[4] + '"'
+    return subprocess.list2cmdline(args)
